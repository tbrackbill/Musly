<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <!-- Debug-only test hook for tools/bt_headunit_test.sh. Lets adb drive
             the Bluetooth resume-on-connect path without a car or any A2DP
             hardware. Exported so `adb shell am broadcast` (shell uid) can
             reach it; compiled into debug builds only. -->
        <receiver
            android:name=".DebugBluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.devid.musly.DEBUG_BT_CONNECT"/>
                <action android:name="com.devid.musly.DEBUG_BT_STATUS"/>
                <action android:name="com.devid.musly.DEBUG_RESUMPTION_PROBE"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
